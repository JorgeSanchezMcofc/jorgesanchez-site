{
  "functions": {
    "api/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "redirects": [
    {
      "source": "/1mc",
      "destination": "/?page=practices",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "energycheck.jorgesanchez.me"
        }
      ],
      "destination": "https://jorgesanchez.me/energycheck/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/snapshot",
      "schedule": "59 5 * * *"
    }
  ]
}
